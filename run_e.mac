# ./sim run.mac out.root [seed] [xmlDir]
# simulated module (these are the defaults): sector half width in azimuth, half length along z,
# and whether the back cryostat wall (incl. solenoid) stays in front of the virtual detector
/module/halfPhiDeg 20
/module/halfZ 1500
/module/cryoBack false
/run/initialize
/gps/particle e-
/gps/ene/mono 50 GeV
# beam fired radially from just in front of the cryostat, spread uniformly over one readout cell
# (cell centre at the calorimeter front: y = 4.4 mm, z = -10.7 mm; cell size ~17.8 x 21.3 mm)
/gps/pos/type Plane
/gps/pos/shape Rectangle
/gps/pos/centre 2100 4.4 -10.7 mm
/gps/pos/rot1 0 1 0
/gps/pos/rot2 0 0 1
/gps/pos/halfx 8.9 mm
/gps/pos/halfy 10.7 mm
/gps/direction 1 0 0
/run/printProgress 100
/run/beamOn 2000
